# Copy this file to .env.local and fill in the tokens you want to use.

# ─── Apify (optional) ─────────────────────────────────────────────────────
# Enables real competitor-ad scraping via Meta Ad Library + Google Transparency.
# Without this, scraper.js falls back to synthetic placeholder ads.
# Get yours at: https://console.apify.com/settings/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── TypeSafe Jev (optional) ──────────────────────────────────────────────
# Enables virality scoring. Without this key, the scoring step is skipped
# and the pipeline flows straight to pending_approval.
# Get yours at: https://typesafe.ai (System One API)
#
# SPECIAL VALUE: set to the literal string "mock" to use the local
# content-aware mock scorer (engine/jev-mock.js). No network, no cost,
# scores derived from the actual creative text so the Launchpad score
# card and single-ad ranking light up with real variation.
#   TYPESAFE_API_KEY=mock
TYPESAFE_API_KEY=your_typesafe_key_here

# Pinned by default so scores stay comparable across campaigns.
# Only change this once you've decided to upgrade and re-baseline.
JEV_MODEL=jev-1.13.0
